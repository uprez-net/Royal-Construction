# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Any nested package (services/*) keeps its own node_modules too.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented, secret-free reference every new checkout copies.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

/lib/generated/prisma

# clerk configuration (can include secrets)
/.clerk/
logs/
backups/
*.dump

/tmp

.vercel
.swc
.output/
.eve/
.vscode/
.playwright-mcp/
.omc/
.impeccable/
package-lock.json
*.png
# Local agent tooling. Never commit: .gstack browse logs carry session
# JWTs and .omo artefacts carry customer names, addresses and prices.
.omo/
.gstack/
.claude/
.mcp.json
.docs-build/

# services/* — standalone packages with their own installs and builds.
# node_modules/ above already covers their dependencies.
services/*/node_modules/
services/*/dist/
services/*/coverage/
# The WhatsApp bridge's runtime state: Baileys auth keys (long-lived private
# keys for the linked device), group mappings, the event outbox and media.
services/*/data/
services/*/.env
services/*/.env.*
!services/*/.env.example
