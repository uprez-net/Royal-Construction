# Keeps editors from reintroducing the CRLF and trailing-whitespace noise that
# .gitattributes and Prettier exist to remove. Prettier's own options in
# .prettierrc.json take precedence over anything set here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{png,jpg,jpeg,gif,ico,webp,avif,pdf,docx,xlsx,zip,woff,woff2,ttf,otf}]
insert_final_newline = false
trim_trailing_whitespace = false
