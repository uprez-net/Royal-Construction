{
  "name": "royal-whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Royal Constructions' WhatsApp group bridge: a Baileys session behind a token-authenticated HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "baileys": "7.0.0-rc14",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
