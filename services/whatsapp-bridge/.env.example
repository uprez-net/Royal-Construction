# Royal WhatsApp bridge — copy to .env and fill in. See README.md.

# Generate each secret with: openssl rand -hex 32
# The app holds the same value as WHATSAPP_BRIDGE_API_TOKEN.
BRIDGE_API_TOKEN=
# The app holds the same value as WHATSAPP_BRIDGE_WEBHOOK_SECRET.
BRIDGE_WEBHOOK_SECRET=

# Where events go: the Royal app's bridge webhook (production or staging).
# Replace app.example.com with the app's domain.
APP_WEBHOOK_URL=https://app.example.com/api/whatsapp-bridge/webhook

# Optional
# LOG_LEVEL=info
# MEDIA_RETENTION_DAYS=14
# MEDIA_MAX_BYTES=104857600

# compose.yaml only
# BRIDGE_DOMAIN=whatsapp-bridge.example.com
# BRIDGE_PORT=8080
