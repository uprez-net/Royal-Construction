generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  ADMIN
  CUSTOMER
  SITE_MANAGER
}

/// Where a project is up to, as the list filters and the header chip read it.
///
/// Append-only, and deliberately not two enums. The three values at the bottom
/// are the compliance ladder and the rest are the build -- but a project is
/// only ever on one of them, because the build does not start until compliance
/// is finished, and a second column would be a second thing to keep in step
/// with the first.
///
/// DRAFT -> COMPLIANCE_STARTED -> COMPLIANCE_COMPLETED -> ACTIVE -> COMPLETED
/// is the whole path. NEEDS_ATTENTION and DELAYED sit outside it: either can be
/// set at any point and neither says anything about which stage the job is on,
/// which is why the ladder is not modelled as an ordering.
enum ProjectStatus {
  ACTIVE
  ON_TRACK
  NEEDS_ATTENTION
  DELAYED
  COMPLETED

  /// Created, and nobody has started on it. The status a project is born on.
  ///
  /// It replaced ACTIVE as the default, which was never true on the day it was
  /// set: a project with no certifier, no compliance file and no milestone
  /// underway is not active in any sense a site manager would recognise, and a
  /// list opening on "Active" showed every job ever created as in flight.
  DRAFT
  /// The certifier has been engaged. Set once and never unset -- the compliance
  /// file exists from that moment, and a job does not go back to DRAFT because
  /// somebody is slow answering.
  COMPLIANCE_STARTED
  /// The construction certificate is on the file and the HBCF cover with it.
  /// Everything the build is not allowed to start without is done, and nothing
  /// on site has begun.
  COMPLIANCE_COMPLETED
}

