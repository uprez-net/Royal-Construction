/// Where one tradie request email stands. "Sent" means the mail server
/// accepted it; a later bounce is not tracked here.
enum TradieRequestDeliveryStatus {
  /// An attempt is in flight.
  SENDING
  SENT
  /// The last attempt failed in a way that was clearly not a send (throttled,
  /// service down). Another attempt is scheduled at nextAttemptAt.
  RETRYING
  /// Needs a person: refused, ambiguous, or the automatic attempts are spent.
  FAILED
}

/// What a tradie request email asks of the tradie.
enum TradieRequestKind {
  /// Price the activities, so several tradies' quotes can be compared.
  QUOTE
  /// The office has chosen this tradie: confirm availability for the dates.
  /// A price can be recorded later without moving the bookings.
  BOOKING
}

enum TradieQuoteSource {
  /// Read from the tradie's emailed reply.
  EMAIL
  /// Entered by the office.
  MANUAL
}

enum TradieQuoteGst {
  INCLUSIVE
  EXCLUSIVE
  /// The tradie is not registered for GST; the amount carries none.
  NOT_REGISTERED
}

enum TradeSelectionStatus {
  ACTIVE
  /// A cancellation is waiting on an admin; the selection still stands.
  CANCELLATION_PENDING
  CANCELLED
}

