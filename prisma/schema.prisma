generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  ADMIN
  CUSTOMER
  SITE_MANAGER
}

enum ProjectStatus {
  ACTIVE
  ON_TRACK
  NEEDS_ATTENTION
  DELAYED
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  DONE
  NOT_REQUIRED
}

enum VariationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TradieScheduleStatus {
  PENDING
  AWAITING_QUOTE
  PENDING_RESPONSE
  QUOTE_RECEIVED
  AWAITING_ADMIN_APPROVAL
  CONFIRMED
  NO_RESPONSE
  DECLINED
  COMPLETED
}

enum MaterialStatus {
  PENDING
  ORDERED
  DELIVERED
  INSTALLED
}

enum LeadStage {
  NEW
  CONTACTED
  /// Collecting the client's requirements. Absorbs the work that used to be
  /// recorded as MEETING_SCHEDULED and IN_FOLLOW_UP, both of which described a
  /// scheduled task rather than how far the deal had progressed.
  DISCOVERY
  QUALIFIED
  QUOTED
  NEGOTIATING
  WON
  LOST
  MEETING_SCHEDULED
  IN_FOLLOW_UP
  NO_RESPONSE
  CONVERTED
  CANCELLED
  DISQUALIFIED
}

/// What the task is. Taken from what people already typed into followupNotes
/// on production, where "Organise a Meeting" appeared 4 times and
/// "Send an Email/Text" twice, because there was no field for it.
enum LeadTaskType {
  CALL
  EMAIL
  MEETING
  WAITING
}

/// Board columns. NEW and DONE cover today's behaviour; IN_PROGRESS exists so
/// the Kanban has a middle column and is not written by anything yet.
enum LeadTaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum LeadValueSource {
  OFFER
  MANUAL
}

/// How to read Tradie.lastQuotedPrice. Without it the number is ambiguous —
/// 120 could be an hourly rate or a whole job — and the schedule cost silently
/// multiplied every value by 8 hours a day regardless.
enum TradiePriceUnit {
  HOURLY
  FIXED
}

enum HistoryType {
  SYSTEM
  CALL
  EMAIL
  REFERRAL
}

enum AnnotationStatus {
  OPEN
  RESOLVED
}

enum OfferStatus {
  // Original values kept in place so the migration only ADDs new members.
  // ACCEPTED is legacy — existing rows are migrated to AGREED; the value is
  // retained to avoid an enum-value drop, remove it in a later migration.
  SENT
  PENDING
  ACCEPTED
  REJECTED
  // New lifecycle members (ADR 0002)
  AGREED
  TENDER_DRAFT
  TENDER_SENT
  TENDER_SIGNED
  CONTRACT_DRAFT
  CONTRACT_SENT
  CONTRACT_SIGNED
  PROJECT
  SUPERSEDED
  // Customer declined the DocuSign envelope — a revise-ready stage the operator
  // clears by creating a new revision (issue #89). The DocuSign decline reason
  // is recorded on the matching OfferStatusEvent.
  TENDER_DECLINED
  CONTRACT_DECLINED
  // Offer-document acceptance signing (ADR 0004). The customer signs the Offer
  // document via DocuSign as a formal acceptance BEFORE the legal Tender:
  // OFFER_SENT (out for signature) → OFFER_SIGNED (all customers signed) then the
  // estimator marks AGREED to generate the Tender; OFFER_DECLINED is revise-ready.
  // Customer-only — the builder does not sign the acceptance.
  OFFER_SENT
  OFFER_SIGNED
  OFFER_DECLINED
}

enum EnvelopeDocType {
  TENDER
  CONTRACT
  // The Offer document signed as a customer acceptance (ADR 0004).
  OFFER
}

enum EnvelopeStatus {
  CREATED
  SENT
  DELIVERED
  COMPLETED
  VOIDED
  DECLINED
}

enum SignerRole {
  BUILDER
  CUSTOMER
}

enum SignerStatus {
  CREATED
  SENT
  DELIVERED
  SIGNED
  DECLINED
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TradieIncidentStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TradieApprovalActionType {
  PRICE_CHANGE
  INCIDENT_RESOLUTION
  TRADIE_REMOVAL
  SCHEDULE_APPROVAL
  SCHEDULE_DELETION
}

enum TradieApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStage {
  Deposit
  Slab
  Frame
  Lockup
  Interior_Fit_Out
  Final
}

/// The certifier engagement's position in the compliance and certification
/// flow. Append-only: a retired value keeps its slot with a comment rather than
/// being deleted, so historical rows stay readable.
enum CertifierEngagementStatus {
  NOT_STARTED
  COLLECTING_DOCS
  OUTREACH_SENT
  AWAITING_RESPONSE
  RESPONSE_RECEIVED
  SIGNING
  CHECKLIST_EXTRACTING
  CHECKLIST_TRACKING
  INSURANCE
  IN_REVIEW
  APPROVED
}

/// What a ComplianceDocument row holds. The first six are the documents the
/// certifier must be sent up front; the next block is what comes back from
/// them; CHECKLIST_ITEM is one line of the returned checklist, tracked as its
/// own row so each can be uploaded and approved independently.
///
/// UNKNOWN is the classifier's fallback. An inbound attachment it cannot place
/// lands here rather than being guessed at — a mislabelled document is worse
/// than an unlabelled one, because only the second is visibly incomplete.
enum ComplianceDocumentType {
  DEPOSITED_PLAN
  TITLE_SEARCH_DETAIL_AND_LEVEL
  SURVEY
  PRELIMINARY_ARCHITECTURAL_PLANS
  PLANNING_CERTIFICATE_10_7
  FULL_ARCHITECTURAL_DESIGN
  /// What the builder holds and the surveyor is sent to start work: the deed
  /// proving who owns the land. It is an input to the required pack rather
  /// than part of it, which is why it is not in REQUIRED_COMPLIANCE_DOCUMENTS
  /// -- the certifier is never sent one.
  LAND_DEED
  INVOICE
  FEE_PROPOSAL
  CDC_FORM
  CHECKLIST
  SIGNED_FEE_PROPOSAL
  SIGNED_CDC_FORM
  CHECKLIST_ITEM
  HOME_INSURANCE
  /// A BASIX certificate, and a bushfire attack level assessment.
  ///
  /// Neither is part of the required pack and neither comes back from the
  /// certifier -- they are what a checklist line asks for, produced by a
  /// consultant nobody has engaged yet. They exist as types so an extracted
  /// line can say which consultant it needs (ChecklistItemDetail.mapsToType),
  /// which is what puts a "Connect with…" control on that row rather than
  /// leaving an admin to work out who to ring.
  BASIX_CERTIFICATE
  BUSHFIRE_REPORT
  UNKNOWN
}

/// PENDING is "we know we need this and do not have it"; UPLOADED is an admin
/// putting it there; RECEIVED is one that arrived on an email from the
/// certifier. The two are kept apart because only the first is something the
/// admin can be asked to redo.
///
/// NOT_REQUIRED is the admin saying this line does not apply to this job -- the
/// certifier struck it through, or already holds the document, or it is a
/// category that does not arise here. It is set by hand and only on a checklist
/// item: nothing infers it. It is deliberately a status rather than a flag,
/// because it is an answer to "where is this document up to" and everything
/// that counts outstanding work already reads status. A NOT_REQUIRED row is
/// never chased, never counted, and never blocks the review send or the
/// engagement closing.
enum ComplianceDocumentStatus {
  PENDING
  UPLOADED
  RECEIVED
  APPROVED
  REJECTED
  NOT_REQUIRED
}

/// LeadEmails infers this by comparing emailFrom against the business mailbox,
/// which breaks the moment mail is sent from an alias. Stored explicitly here:
/// the thread view renders each bubble's side from it.
enum CertifierEmailDirection {
  INBOUND
  OUTBOUND
}

model Project {
  id               String   @id @default(uuid())
  leadId           Int      @unique
  name             String
  description      String?
  buildingType     String   @default("Double Storey 4BR + Study")
  lotSize          Decimal? @db.Decimal(10, 2)
  council          String   @default("Sydney City Council")
  customerId       String
  location         String
  siteManagerId    String?
  totalBudget      Decimal  @db.Decimal(12, 2)
  spent            Decimal  @default(0) @db.Decimal(12, 2)
  startDate        DateTime
  estimatedEndDate DateTime
  requirements     Json?
  // Full owner party set carried over from the offer at handoff (ADR 0003):
  // every owner (individual or company + directors), both addresses, and
  // per-owner contact. The primary owner is also promoted to the Customer row;
  // this JSON preserves the co-owners the single Customer can't hold.
  parties          Json?

  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  customer            Customer             @relation("CustomerProjects", fields: [customerId], references: [id])
  siteManager         User?                @relation("SiteManagerProjects", fields: [siteManagerId], references: [id])
  Lead                Lead                 @relation("LeadProject", fields: [leadId], references: [id], onDelete: Cascade)
  milestones          Milestone[]
  siteUpdates         SiteUpdate[]
  variations          Variation[]
  tradieSchedules     TradieSchedule[]
  files               File[]               @relation("ProjectFiles")
  activityLogs        ActivityLog[]
  materials           Material[]
  tradies             Tradie[]             @relation("ProjectTradies")
  certifierEngagement CertifierEngagement? @relation("ProjectCertifierEngagement")
  invoices            Invoice[]

  @@index([name])
  @@index([customerId])
  @@index([siteManagerId])
  @@index([status])
}

model Milestone {
  id              String          @id @default(uuid())
  projectId       String
  name            String
  order           Int
  description     String?
  projectStage    ProjectStage
  targetDate      DateTime
  startDate       DateTime?
  actualDate      DateTime?
  budget          Decimal         @default(10000) @db.Decimal(12, 2)
  spend           Decimal?        @db.Decimal(12, 2)
  status          MilestoneStatus @default(PENDING)
  isPhotoRequired Boolean         @default(false)
  parentId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteUpdates        SiteUpdate[]
  tradieSchedules    TradieSchedule[]
  activityLogs       ActivityLog[]
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files              File[]           @relation("MilestoneFiles")
  tradies            Tradie[]         @relation("TradieMilestones")
  parentMilestone    Milestone?       @relation("MilestoneHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  childrenMilestones Milestone[]      @relation("MilestoneHierarchy")

  @@unique([projectId, order])
  @@index([projectId])
  @@index([status])
}

model Material {
  id             String         @id @default(uuid())
  projectId      String
  name           String
  category       String
  specifications String?
  quantity       Int
  unitCost       Decimal        @db.Decimal(10, 2)
  totalCost      Decimal        @db.Decimal(12, 2)
  status         MaterialStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Tradie {
  id                  String          @id @default(uuid())
  name                String
  trade               String
  abn                 String          @unique
  phone               String          @unique
  email               String          @unique
  additionalEmails    String[]        @default([])
  location            String?
  isFavourite         Boolean         @default(false)
  lastQuotedPrice     Decimal?        @db.Decimal(8, 2)
  /// Defaults to HOURLY: every existing row was entered under the old
  /// hourly-only behaviour, so anything else would silently restate project
  /// costs already on screen.
  lastQuotedPriceUnit TradiePriceUnit @default(HOURLY)
  rating              Decimal?        @db.Decimal(2, 1)
  note                String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]        @relation("ProjectTradies")
  milestones Milestone[]      @relation("TradieMilestones")
  schedules  TradieSchedule[]
  incidents  TradieIncident[]
  approvals  TradieApproval[]
  ratings    TradieRating[]

  complianceOutreaches ComplianceOutreach[] @relation("TradieComplianceOutreaches")

  @@index([name])
  @@index([trade])
  @@index([email])
  @@index([phone])
}

model TradieIncident {
  id          String           @id @default(uuid())
  tradieId    String
  type        String
  severity    IncidentSeverity
  description String           @db.Text
  resolution  String?          @db.Text

  status TradieIncidentStatus @default(OPEN)

  createdAt DateTime @default(now())

  tradie Tradie @relation(fields: [tradieId], references: [id], onDelete: Cascade)
  files  File[] @relation("TradieIncidentFiles")

  @@index([tradieId])
  @@index([severity])
}

model TradieApproval {
  id              String                   @id @default(uuid())
  tradieId        String
  actionType      TradieApprovalActionType
  status          TradieApprovalStatus     @default(PENDING)
  reason          String                   @db.Text
  updationData    Json?
  rejectionReason String?                  @db.Text
  requestedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradie Tradie @relation(fields: [tradieId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([requestedBy])
}

model TradieRating {
  id       String  @id @default(uuid())
  tradieId String
  userId   String
  rating   Decimal @db.Decimal(2, 1)
  comment  String? @db.Text

  createdAt DateTime @default(now())

  tradie Tradie @relation(fields: [tradieId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tradieId])
  @@index([userId])
}

model File {
  id                   String   @id @default(uuid())
  projectId            String?
  milestoneId          String?
  leadId               Int?
  incidentId           String?
  complianceDocumentId String?
  filename             String
  fileType             String
  filesize             Int
  url                  String
  uploadedBy           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project            Project?            @relation("ProjectFiles", fields: [projectId], references: [id], onDelete: Cascade)
  milestone          Milestone?          @relation("MilestoneFiles", fields: [milestoneId], references: [id], onDelete: Cascade)
  lead               Lead?               @relation("LeadFiles", fields: [leadId], references: [id], onDelete: Cascade)
  incident           TradieIncident?     @relation("TradieIncidentFiles", fields: [incidentId], references: [id], onDelete: Cascade)
  complianceDocument ComplianceDocument? @relation("ComplianceDocumentFiles", fields: [complianceDocumentId], references: [id], onDelete: Cascade)
  User               User                @relation("UserFiles", fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([milestoneId])
  @@index([incidentId])
  @@index([complianceDocumentId])
  @@index([leadId])
  @@index([uploadedBy])
}

model SiteUpdate {
  id          String   @id @default(uuid())
  projectId   String
  milestoneId String?
  authorId    String
  notes       String
  photoUrls   String[]

  createdAt DateTime @default(now())

  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  author    User       @relation(fields: [authorId], references: [id])
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([milestoneId])
}

model Variation {
  id            String          @id @default(uuid())
  projectId     String
  description   String
  cost          Decimal         @db.Decimal(10, 2)
  requestedDate DateTime        @default(now())
  approvedDate  DateTime?
  delayDays     Int             @default(0)
  status        VariationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model TradieSchedule {
  id             String               @id @default(uuid())
  tradieId       String
  projectId      String
  milestoneId    String?
  scheduledDate  DateTime
  durationDays   Int                  @default(1)
  requiresQuote  Boolean              @default(false)
  quotedPrice    String?
  status         TradieScheduleStatus @default(PENDING)
  reminderSentAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tradie    Tradie     @relation(fields: [tradieId], references: [id])
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([tradieId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([scheduledDate])
}

model ActivityLog {
  id          String  @id @default(uuid())
  projectId   String
  milestoneId String?
  authorId    String?
  type        String
  message     String

  createdAt DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?      @relation(fields: [authorId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([projectId])
  @@index([milestoneId])
  @@index([createdAt])
}

model Customer {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  phone         String  @unique
  // Primary owner's Current Location (residential/postal address). Populated at
  // project handoff from the offer's owners[] (ADR 0003). Nullable — legacy
  // customers have none.
  address       String?
  /// The Xero ContactID this customer is billed under. Resolved lazily the
  /// first time a progress claim is raised (match on email, else create), so
  /// legacy customers carry null until their first invoice.
  xeroContactId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[] @relation("CustomerProjects")

  @@index([email])
  @@index([phone])
}

model User {
  id         String  @id @default(uuid())
  name       String
  email      String  @unique
  phone      String  @unique
  role       Role    @default(CUSTOMER)
  customerId String?
  clerkId    String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files               File[]           @relation("UserFiles")
  siteManagerProjects Project[]        @relation("SiteManagerProjects")
  siteUpdates         SiteUpdate[]
  activityLogs        ActivityLog[]
  assignedLeads       Lead[]           @relation("LeadAssignee")
  leadHistories       LeadHistory[]    @relation("LeadHistoryAuthor")
  leadTasks           LeadTask[]       @relation("LeadTaskAssignee")
  reviews             TradieRating[]
  approvalRequests    TradieApproval[]
  createdOffers       Offer[]          @relation("OfferCreatedBy")
  xeroConnections     XeroConnection[] @relation("XeroConnections")

  resolvedComplianceAlerts ComplianceAlert[] @relation("UserResolvedComplianceAlerts")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([clerkId])
}

model Lead {
  id Int @id @default(autoincrement())

  name     String
  phone    String @default("")
  email    String @default("")
  location String @default("")

  // Secondary client — optional second person on the same lead.
  // Nullable ADD COLUMN, no data loss; primary name/phone/email remain the
  // canonical client.
  secondaryName  String?
  secondaryEmail String?
  secondaryPhone String?

  source       String?
  sourceDetail String?

  stage      LeadStage  @default(NEW)
  isArchived Boolean    @default(false)
  runId      String?
  runStatus  RunStatus?

  assignedId String? // <-- THE NEW FOREIGN KEY

  assigned String?

  budget String?
  type   String[]

  notes    String? @db.Text
  notesDoc Json?

  followupDate           DateTime?
  followupTime           String?
  followupNotes          String?   @db.Text
  meetingDate            DateTime?
  meetingTime            String?
  meetingMode            String?
  followupReminderSentAt DateTime?
  meetingReminderSentAt  DateTime?
  /// When the scheduled task was closed out. Before these existed, the only
  /// record that a follow-up had finished was the stage flipping to CONTACTED,
  /// which is why a lead in negotiation lost 50 points for having a call
  /// rescheduled. The stage no longer moves; these do.
  followupCompletedAt    DateTime?
  meetingCompletedAt     DateTime?

  lostReason String?

  urgent Boolean @default(false)

  // ── Deal economics ────────────────────────────────────────────────
  /// Numeric deal value. Auto-filled from the active offer's contract price
  /// unless estimatedValueSource is MANUAL. `budget` above remains a
  /// free-text note and is NOT the source of truth for any KPI.
  estimatedValue       Decimal?         @db.Decimal(14, 2)
  estimatedValueSource LeadValueSource?
  /// Null means "inherit the stage default" (lib/leads/pipeline-stages.ts).
  /// Never default this to 0 — that would read as 0% for every existing lead.
  probabilityOverride  Int?
  expectedCloseDate    DateTime?
  /// Stamped by closeDatePatch() on stage transitions. Weighted pipeline and
  /// win rate depend on these; updatedAt is not a usable substitute.
  wonAt                DateTime?
  lostAt               DateTime?

  MicrosoftmessageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers          Offer[]
  chatSessions    ChatSession[]
  history         LeadHistory[]
  tasks           LeadTask[]
  noteAnnotations LeadNoteAnnotation[]
  files           File[]               @relation("LeadFiles")
  emails          LeadEmails[]         @relation("LeadEmails")
  assignedUser    User?                @relation("LeadAssignee", fields: [assignedId], references: [id]) // <-- THE NEW RELATION
  project         Project?             @relation("LeadProject")

  @@index([stage])
  @@index([assignedId])
  @@index([createdAt])
  @@index([expectedCloseDate])
  @@index([wonAt])
  @@index([lostAt])
}

model LeadNoteAnnotation {
  id String @id @default(uuid())

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  selectedText     String           @db.Text
  comment          String           @db.Text
  mentionedUserIds String[]
  status           AnnotationStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([leadId])
  @@index([status])
}

/// Scheduled work on a lead: one row per task, many per lead.
///
/// Replaces the single followupDate / meetingDate pair on Lead, which could
/// hold one follow-up and one meeting ever and overwrote the previous one on
/// every save. Production has logged 54 "New Followup Stage Created" against 41
/// leads, so that overwrite has been losing history for as long as the feature
/// has existed.
///
/// A task never changes the lead's stage. That rule is the whole reason this
/// table exists: scheduled work used to BE the stage, so completing a follow-up
/// wrote CONTACTED and cost a deal in negotiation 50 points.
model LeadTask {
  id Int @id @default(autoincrement())

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type   LeadTaskType
  status LeadTaskStatus @default(NEW)

  /// When the work is due. Null means "no date yet", which is the state 5
  /// production leads are parked in today while the UI reports "All caught up".
  dueDate DateTime?
  dueTime String?

  notes String? @db.Text

  assignedId String?
  assignedTo User?   @relation("LeadTaskAssignee", fields: [assignedId], references: [id])

  /// Set when the task is closed out. Nothing recorded this before; the stage
  /// flipping to CONTACTED was the only signal a follow-up had finished.
  completedAt    DateTime?
  /// Guards against re-notifying. Mirrors followupReminderSentAt on Lead.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([assignedId])
  @@index([status])
  /// The reminder crons and the Follow-ups tab both scan open work by date.
  @@index([dueDate, completedAt])
}

model LeadHistory {
  id Int @id @default(autoincrement())

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("LeadHistoryAuthor", fields: [authorId], references: [id])

  action String
  detail String @db.Text

  type HistoryType

  actionDate DateTime

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([authorId])
  @@index([type])
}

model Offer {
  id          String      @id @default(uuid())
  leadId      Int
  offerStatus OfferStatus @default(PENDING)

  // Revision family — many offers per lead, one active. See ADR 0002.
  baseReference  String  @default("")
  revisionNumber Int     @default(1)
  isActive       Boolean @default(true)
  supersededById String?
  supersededBy   Offer?  @relation("OfferRevisions", fields: [supersededById], references: [id], onDelete: SetNull)
  revisions      Offer[] @relation("OfferRevisions")

  createdById String?
  createdBy   User?   @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  amount              Decimal  @db.Decimal(12, 2)
  gstAmount           Decimal  @db.Decimal(12, 2)
  totalAmount         Decimal  @db.Decimal(12, 2)
  contractValueIncGst Decimal? @db.Decimal(12, 2)

  // Hybrid working-state: integer cents + schemaVersion; frozen at agreed.
  stateVersion   Int   @default(0) // optimistic concurrency
  workspaceState Json?
  agreedSnapshot Json?

  sentAt     DateTime?
  acceptedAt DateTime?

  // Executed (fully signed) Offer-acceptance PDF, archived to Blob by the
  // DocuSign Connect webhook when the OFFER envelope completes (ADR 0004).
  // Parallels Tender.executedPdfUrl / Contract.executedPdfUrl.
  executedPdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerItems          OfferItem[]
  offerFiles          OfferFile[]
  tender              Tender?
  contract            Contract?
  acceptanceEnvelopes Envelope[]          @relation("OfferAcceptanceEnvelopes")
  documentSends       OfferDocumentSend[]
  statusEvents        OfferStatusEvent[]
  lead                Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // NOTE: one-active-per-lead is enforced via a partial unique index
  // (CREATE UNIQUE INDEX ... WHERE "isActive") added in the migration, since
  // Prisma cannot express a filtered unique in the schema.
  @@index([leadId])
  @@index([isActive])
  @@index([baseReference])
}

model OfferItem {
  id          String  @id @default(uuid())
  offerId     String
  item        String
  description String
  quantity    Int
  unit        String
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  version Int @default(1)

  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model OfferFile {
  id        String   @id @default(uuid())
  offerId   String
  version   Int      @default(1)
  filename  String
  fileType  String
  filesize  Int
  url       String
  createdAt DateTime @default(now())

  offerContent Json

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, version])
  @@index([offerId])
}

// ─── Offer workflow: Tender / Contract / DocuSign envelopes (ADR 0002) ───

model Tender {
  id             String     @id @default(uuid())
  offerId        String     @unique
  offer          Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  version        Int        @default(1)
  documentData   Json
  executedPdfUrl String?
  envelopes      Envelope[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([offerId])
}

model Contract {
  id             String     @id @default(uuid())
  offerId        String     @unique
  offer          Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  version        Int        @default(1)
  documentData   Json
  // Estimator-entered BC4 particulars (issue #98) captured during CONTRACT_DRAFT
  // and sent as locked tabs, so the contract routes to the customer first with
  // the builder's fields already complete. Shape: lib/offer/contract-particulars.
  particulars    Json?
  executedPdfUrl String?
  envelopes      Envelope[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([offerId])
}

// One row per DocuSign send; re-sends are retained for legal audit. An envelope
// hangs off exactly one parent: a Tender, a Contract, or (for an OFFER-type
// acceptance envelope, ADR 0004) the Offer directly.
model Envelope {
  id              String              @id @default(uuid())
  docType         EnvelopeDocType
  tenderId        String?
  tender          Tender?             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract?           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // Set only for docType OFFER: the acceptance envelope hangs directly off the
  // Offer (no intermediate Tender/Contract record). ADR 0004.
  offerId         String?
  offer           Offer?              @relation("OfferAcceptanceEnvelopes", fields: [offerId], references: [id], onDelete: Cascade)
  docusignId      String?             @unique
  status          EnvelopeStatus      @default(CREATED)
  documentVersion Int
  sentAt          DateTime?
  completedAt     DateTime?
  voidedAt        DateTime?
  signatures      EnvelopeSignature[]
  createdAt       DateTime            @default(now())

  @@index([tenderId])
  @@index([contractId])
  @@index([offerId])
  @@index([status])
}

model EnvelopeSignature {
  id                  String       @id @default(uuid())
  envelopeId          String
  envelope            Envelope     @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipientRole       SignerRole
  name                String
  email               String
  routingOrder        Int
  status              SignerStatus @default(CREATED)
  signedAt            DateTime?
  lastReminderAt      DateTime?
  reminderCount       Int          @default(0)
  docusignRecipientId String?
  // Signing capacity + represented entity (ADR 0003). capacity is "Owner" for
  // an individual, "Director" for a company director. entityName/entityAbn name
  // the company a director signs for (null for individuals). Purely descriptive
  // audit metadata; recipientRole stays BUILDER|CUSTOMER.
  capacity            String?
  entityName          String?
  entityAbn           String?

  @@index([envelopeId])
  @@index([status])
}

// Each send of the negotiation Offer document, with tracked link + open telemetry.
model OfferDocumentSend {
  id               String    @id @default(uuid())
  offerId          String
  offer            Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerFileVersion Int
  recipientEmail   String
  trackedLinkToken String    @unique
  sentAt           DateTime  @default(now())
  openedAt         DateTime?
  // Reply tracking: the subject carries [RCOFR-…] so inbound replies correlate
  // back to this send (see lib/graph/offer-reply-tracker).
  repliedAt        DateTime?
  lastReplyAt      DateTime?

  @@index([offerId])
}

// One row per lifecycle transition, for accountability + legal trail.
model OfferStatusEvent {
  id         String       @id @default(uuid())
  offerId    String
  offer      Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  fromStatus OfferStatus?
  toStatus   OfferStatus
  actorId    String?
  note       String?
  at         DateTime     @default(now())

  @@index([offerId])
  @@index([at])
}

// Global per-year sequence for base offer references (RC-Q-YYYY-NNN).
model OfferReferenceCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model ChatSession {
  id     String @id @default(uuid())
  leadId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model ChatMessage {
  id        String @id @default(uuid())
  sessionId String
  role      String
  content   Json

  timestamp DateTime @default(now())

  chatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model EmailAdHock {
  id              String   @id @default(uuid())
  name            String
  emailSubject    String
  htmlUrl         String
  attachmentsUrls String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("email_adhoc")
}

model LeadEmails {
  id        String   @id @default(uuid())
  leadId    Int
  emailFrom String
  emailTo   String
  subject   String
  body      String   @db.Text
  checksum  String   @unique @db.Text
  sentAt    DateTime

  createdAt DateTime @default(now())

  lead Lead @relation("LeadEmails", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([emailFrom])
  @@index([leadId, sentAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
}

model AdminOfferContent {
  id           String   @id @default(uuid())
  buildScope   String[]
  costSchedule Json
  offerScope   Json
  offerContent Json
  hbfcClaim    Json     @default("{\"claimAmount\": 800000}")
  // Bumped by every per-section save. Each Offer stamps the version it was
  // built from into Offer.workspaceState, so opening a still-editable offer can
  // detect that admin content moved on and re-apply the current defaults, while
  // an agreed/sent offer keeps its frozen snapshot.
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One project's dealings with its principal certifier, from the first document
/// pack through to every checklist item being approved.
///
/// One per project, mirroring Project.leadId: the owning side holds the unique
/// scalar FK and Project carries only the back-reference.
///
/// refToken is what makes the mail loop work. It is minted here, carried in the
/// outreach subject as "[RCCERT-…]", and quoted back by every reply, which is
/// how an inbound message is correlated to this row without trusting the
/// sender's address. Same mechanism as OfferDocumentSend.trackedLinkToken.
model CertifierEngagement {
  id             String  @id @default(uuid())
  projectId      String  @unique
  refToken       String  @unique
  /// The site address, appended to refToken to make a subject a human can read.
  subjectAddress String
  /// Denormalised snapshots rather than a relation, as EnvelopeSignature does
  /// for signers: the certifier is a third party with no account here, and the
  /// engagement should still read correctly if they are later replaced.
  certifierName  String?
  certifierEmail String?
  certifierPhone String?

  /// The Graph id of the most recent inbound message on this thread.
  ///
  /// Replies are built with Graph's createReply against it, which is the only
  /// way to get real In-Reply-To and References headers — Graph refuses to set
  /// either through internetMessageHeaders, so a plain send threads on subject
  /// alone and comes apart the moment a client normalises it. Null until the
  /// certifier has answered once, and replies fall back to a subject-threaded
  /// send until then.
  lastInboundMessageId String?

  status CertifierEngagementStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project             Project                         @relation("ProjectCertifierEngagement", fields: [projectId], references: [id], onDelete: Cascade)
  documents           ComplianceDocument[]
  emails              CertifierEmail[]
  outreaches          ComplianceOutreach[]
  alerts              ComplianceAlert[]
  planningCertificate PlanningCertificateApplication?

  @@index([status])
}

/// One tracked document on the engagement — a required document, something the
/// certifier sent back, a signed copy, or a single checklist line.
///
/// order is deliberately NOT unique per engagement. Milestone pays for
/// @@unique([projectId, order]) with a descending row-shift on every insert
/// (lib/data/milestones.ts); checklist items are written once as a batch and
/// never reordered, so the constraint would buy nothing and cost that.
model ComplianceDocument {
  id              String                   @id @default(uuid())
  engagementId    String
  documentType    ComplianceDocumentType
  status          ComplianceDocumentStatus @default(PENDING)
  /// The checklist line as the certifier worded it. Null for the fixed types,
  /// whose label comes from constants/complianceDocuments.ts.
  label           String?
  order           Int                      @default(0)
  rejectionReason String?
  /// What the extraction read about this line beyond its name -- the clarifying
  /// description, the conditions the file has to satisfy, the standards and
  /// instruments it cites. Display-only and optional everywhere: null on every
  /// row written before the richer extraction, and on every fixed type, whose
  /// name comes from constants/complianceDocuments.ts.
  ///
  /// Shape depends on documentType and is parsed defensively at the boundary
  /// (types/compliance.ts), the way CertifierEmail.attachments already is.
  detail          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement CertifierEngagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  files      File[]               @relation("ComplianceDocumentFiles")
  /// The consultants engaged off this line, where it is a checklist item that
  /// asked for one. Zero or one in practice -- the unique index on
  /// [engagementId, party] is what actually holds that.
  outreaches ComplianceOutreach[] @relation("ChecklistDocumentOutreaches")

  @@index([engagementId])
  @@index([engagementId, order])
  @@index([status])
}

/// The mail trail with the certifier, in and out.
///
/// checksum is the dedup key, following LeadEmails: Graph re-notifies, a
/// workflow step retries, and a thread quotes its own history, so the same
/// message reaches this table more than once. The unique index is what makes
/// createMany({ skipDuplicates: true }) safe to call blindly.
model CertifierEmail {
  id           String                  @id @default(uuid())
  engagementId String
  emailFrom    String
  emailTo      String
  subject      String
  body         String                  @db.Text
  checksum     String                  @unique @db.Text
  direction    CertifierEmailDirection
  /// [{ name, url }] — blob-backed copies of the message's attachments, so a
  /// bubble can link them without a second query.
  attachments  Json                    @default("[]")
  sentAt       DateTime

  /// Which thread this message belongs to. Null is the certifier's own thread,
  /// which is the only one that existed when this table was written and the
  /// only one every existing row can be. A set value files the message under
  /// one of the other parties -- surveyor, architect, council -- whose threads
  /// are the same shape and are read by the same components, so they share the
  /// table rather than growing a near-identical one per party.
  outreachId String?

  createdAt DateTime @default(now())

  engagement CertifierEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  outreach   ComplianceOutreach? @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([engagementId, sentAt(sort: Desc)])
  @@index([outreachId, sentAt(sort: Desc)])
}

/// The third parties a compliance file talks to besides the certifier.
///
/// The certifier is deliberately absent. It is not a party in this sense -- it
/// owns the engagement row itself, holds the document set, and every existing
/// certifier read and write goes through CertifierEngagement. Adding it here
/// would mean two places claiming to know who the certifier is.
enum CompliancePartyType {
  SURVEYOR
  ARCHITECT
  /// The NSW Planning Portal, for the 10.7(2) & (5) certificate. Never sent to
  /// from here today -- the row is written when the certificate application is
  /// recorded, so the certificate has a thread to be filed against when one
  /// arrives at the watched address.
  COUNCIL
  /// The two consultants a certifier's checklist routinely calls for.
  ///
  /// Unlike the three above they are not part of the required pack and are not
  /// known when the file opens: they are engaged mid-checklist, off a line that
  /// asks for a BASIX certificate or a bushfire assessment. Same outreach, same
  /// thread, same inbound correlation -- what differs is only when they enter.
  BASIX_CONSULTANT
  BUSHFIRE_CONSULTANT
}

/// How a party's documents are being obtained.
///
/// SELF_SUPPLIED is the client turning up with their own surveyor's plans or
/// their architect's drawings, which happens often enough that treating it as
/// an absence stranded the whole file: the section stayed locked, and with it
/// everything gated behind that party. It is a row rather than a null so it
/// still answers "is this stage settled" for the sections downstream, and so
/// the tab can say the documents came from the client rather than from us.
enum ComplianceOutreachMode {
  OUTREACH
  SELF_SUPPLIED
}

/// Where one party's outreach has got to.
///
/// Deliberately coarser than CertifierEngagementStatus. The certifier drives a
/// multi-stage flow of its own -- fee proposal, signing, checklist, review --
/// while a surveyor or an architect is asked once for a fixed set of documents
/// and either has sent them or has not.
enum ComplianceOutreachStatus {
  /// A SELF_SUPPLIED row, or one created before its mail went out.
  NOT_SENT
  SENT
  RESPONSE_RECEIVED
  COMPLETE
}

/// Something that has come back from a party that changes what the rest of the
/// file needs, and that a person has to close out.
///
/// Append-only, like CertifierEngagementStatus: a retired value keeps its slot.
enum ComplianceAlertType {
  /// The surveyor's title search predates the transfer, so it still shows the
  /// previous owner. Resolved only when a replacement search naming the current
  /// owners has been supplied and checked.
  STALE_TITLE_SEARCH
  /// The architect says the proposal cannot go through as a CDC and needs
  /// development approval. While this is open the 10.7 certificate stops being
  /// required and the DA section opens; it closes when the DA is granted.
  DA_APPROVAL_REQUIRED

  // ---------------------------------------------------------------------
  // Overdue conditions.
  //
  // Every one of these is raised by the daily sweep in
  // /api/cron/compliance-alerts rather than by anything a party sends, which
  // is what makes them a different kind of alert from the two above: nothing
  // arrives to raise them, so the absence has to be looked for. Each one has a
  // clock, a threshold and a chase, and each closes itself the moment the
  // thing it is waiting for lands.
  //
  // Deliberately one type per party rather than a single PARTY_RESPONSE_OVERDUE
  // carrying the party in raisedBySource. At most one alert of a type is open
  // per file, so a shared type would mean a job waiting on both the surveyor
  // and a BASIX consultant could only ever say one of those out loud.
  // ---------------------------------------------------------------------

  /// The planning certificate application has been lodged and the portal has
  /// not answered inside its own quoted turnaround.
  PLANNING_CERTIFICATE_DELAYED
  /// The surveyor was written to and has sent nothing back.
  SURVEYOR_RESPONSE_OVERDUE
  /// The client and architect met, and no preliminary plans have followed.
  ARCHITECT_PLANS_OVERDUE
  /// The client asked for revisions and the architect has not re-issued.
  ARCHITECT_REVISION_OVERDUE
  /// The BASIX consultant was engaged and has sent no certificate back.
  BASIX_RESPONSE_OVERDUE
  /// The bushfire consultant was engaged and has sent no assessment back.
  BUSHFIRE_RESPONSE_OVERDUE
}

enum ComplianceAlertStatus {
  OPEN
  RESOLVED
}

/// Who an alert came from.
///
/// A superset of CompliancePartyType, and a separate enum rather than an
/// extension of it, because the certifier belongs in exactly one of the two.
/// They can tell us a job needs a DA -- often catching what the architect
/// missed, which is the whole reason this exists -- but they are not an
/// outreach party: they own the engagement row, and a CERTIFIER value on
/// ComplianceOutreach.party would be a row nothing in the flow can render or
/// gate on.
enum ComplianceAlertSource {
  SURVEYOR
  ARCHITECT
  COUNCIL
  CERTIFIER
  BASIX_CONSULTANT
  BUSHFIRE_CONSULTANT
}

/// One party's engagement on a compliance file.
///
/// The same shape as CertifierEngagement's own correlation fields -- a minted
/// refToken carried in the subject, a denormalised contact snapshot, and the
/// Graph id of the last inbound message to reply against -- because the mail
/// loop is identical. What differs is that there can be several of these per
/// file and the certifier is only ever one, which is why the certifier keeps
/// its columns on the engagement rather than moving here.
///
/// tradieId is a soft link. The party is picked from the tradie directory, but
/// the name and address are snapshotted the way EnvelopeSignature does: a
/// tradie who is later deleted or has their email corrected must not silently
/// change who a finished thread was addressed to.
model ComplianceOutreach {
  id           String              @id @default(uuid())
  engagementId String
  party        CompliancePartyType

  /// Minted here and carried in every subject on this thread -- "[RCSURV-...]",
  /// "[RCARCH-...]". Unique across parties, so one lookup resolves any of them.
  refToken String @unique

  mode   ComplianceOutreachMode   @default(OUTREACH)
  status ComplianceOutreachStatus @default(NOT_SENT)

  tradieId     String?
  contactName  String?
  contactEmail String?
  contactPhone String?

  /// See CertifierEngagement.lastInboundMessageId -- Graph will not set
  /// In-Reply-To through internetMessageHeaders, so a reply has to be built
  /// with createReply against the message it answers.
  lastInboundMessageId String?

  /// When the opening mail actually went out.
  ///
  /// The clock every overdue alert on this party is measured from, and
  /// deliberately not updatedAt: that moves on a follow-up, on a reply landing,
  /// on a meeting being booked, and an SLA measured from it would reset itself
  /// every time somebody touched the row. Null on a SELF_SUPPLIED row and on
  /// one whose send never completed -- neither of which is waiting on anybody.
  sentAt DateTime?

  /// When this party was last chased, from the alert panel or by the sweep.
  ///
  /// Read only to keep the daily sweep from re-raising a condition somebody has
  /// already acted on. It is not a resolution: chasing is not answering, and
  /// the alert closes when the documents arrive.
  lastFollowUpAt DateTime?

  /// When the client signed off on the preliminary plans. Architect rows only.
  ///
  /// The gate on sending the pack to the certifier. Held here rather than as a
  /// status because it is one irreversible fact about one party's work, and
  /// because the revision rounds that precede it are their own rows below.
  clientPlansApprovedAt DateTime?

  /// The checklist line this outreach was raised off, for the consultants.
  ///
  /// A BASIX or bushfire consultant is engaged mid-checklist against one item,
  /// and what they send back satisfies that item rather than becoming a
  /// document of its own -- so the row that asked has to be recorded when the
  /// outreach opens, not guessed at when the reply arrives. Null for the three
  /// parties that are engaged off the required pack instead.
  checklistDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement        CertifierEngagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  tradie            Tradie?                  @relation("TradieComplianceOutreaches", fields: [tradieId], references: [id], onDelete: SetNull)
  emails            CertifierEmail[]
  checklistDocument ComplianceDocument?      @relation("ChecklistDocumentOutreaches", fields: [checklistDocumentId], references: [id], onDelete: SetNull)
  meetings          ComplianceMeeting[]
  revisions         CompliancePlanRevision[]

  /// One outreach per party per file. A second "Connect with Surveyor" on a
  /// file that already has one is the same act repeated, not a new thread.
  @@unique([engagementId, party])
  @@index([engagementId])
  @@index([status])
  @@index([checklistDocumentId])
}

/// Where one client/architect meeting got to.
///
/// RESCHEDULED is terminal on the row it is set on rather than pending:
/// rescheduling closes this row and writes a new SCHEDULED one for the new
/// time, so the trail says what moved and when. HELD is what starts the clock
/// on the preliminary plans.
enum ComplianceMeetingStatus {
  SCHEDULED
  HELD
  RESCHEDULED
}

/// One meeting between the client and the architect.
///
/// A table rather than a pair of columns on the outreach, because the whole
/// point of the resolution step is that a meeting can move: a job routinely
/// books one, moves it, and then holds it, and two columns would remember only
/// the last of those. What is being tracked is the date the plans clock starts
/// from, and it has to be defensible against the two reschedules before it.
model ComplianceMeeting {
  id         String @id @default(uuid())
  outreachId String

  /// The time it is booked for. Stored as an instant and rendered in Sydney.
  scheduledFor DateTime

  status ComplianceMeetingStatus @default(SCHEDULED)

  /// When it actually happened. Taken from scheduledFor when somebody records
  /// that it took place, so the plans clock runs off the meeting rather than
  /// off the click that reported it days later.
  heldAt DateTime?

  /// Anything the admin added -- for a reschedule, why it moved.
  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreach ComplianceOutreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([outreachId])
  @@index([outreachId, status])
}

/// One round of client feedback on the architect's preliminary plans.
///
/// Written when the client says no, closed when a replacement set arrives. The
/// gap between the two is what ARCHITECT_REVISION_OVERDUE measures, which is
/// why respondedAt is a column rather than being inferred from the plans' own
/// upload time -- a file replaced for an unrelated reason must not silently
/// answer a revision nobody addressed.
model CompliancePlanRevision {
  id         String @id @default(uuid())
  outreachId String

  /// The client's words, sent to the architect verbatim.
  feedback String @db.Text

  requestedAt DateTime  @default(now())
  /// When revised plans landed against this round. Null while outstanding.
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreach ComplianceOutreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([outreachId])
  @@index([outreachId, respondedAt])
}

/// The 10.7(2) & (5) certificate, as a thing being obtained rather than a file.
///
/// The council block used to ask "do you already have the planning
/// certificate?" and hold the answer in component state. That was honest while
/// the only two outcomes were "upload it" and "go and buy one" -- but buying
/// one takes the portal three to five days, and nothing on the file recorded
/// that an application existed at all, so a job could sit for a fortnight with
/// an unanswered question on screen and nobody able to tell whether anybody had
/// acted on it.
///
/// One row per engagement, created the moment the question is answered. Every
/// field after alreadyHeld is null until the step that fills it, and the block
/// renders whichever step that leaves it on.
model PlanningCertificateApplication {
  id           String @id @default(uuid())
  engagementId String @unique

  /// The answer to "do you already have the planning certificate?".
  /// Null means nobody has been asked yet.
  alreadyHeld Boolean?

  /// When the application was lodged, as the admin reports it -- not when they
  /// typed it in. The portal's turnaround is measured from lodgement.
  appliedAt      DateTime?
  /// The portal's own application number, for chasing it by phone.
  applicationRef String?
  /// Which council or portal it went to. Deliberately not prefilled from the
  /// project's council: the two are usually the same and occasionally are not,
  /// and a wrong prefilled answer is worse than an empty one.
  lodgedWith     String?

  /// When the certificate came back. Set by hand from the block, and by the
  /// upload that supplies the certificate if nobody ticked it first.
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement CertifierEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
}

/// A condition raised on a compliance file that blocks or reshapes what comes
/// after it, held open until someone closes it.
///
/// A table rather than a flag on the engagement because these arrive from
/// outside, arrive more than once, and each carries its own resolution --
/// a replacement document, a granted approval. A flag would record that
/// something was wrong without recording what, when, or whether it was fixed.
model ComplianceAlert {
  id           String                @id @default(uuid())
  engagementId String
  type         ComplianceAlertType
  status       ComplianceAlertStatus @default(OPEN)

  /// Whose message raised it, where one did. Null for an alert an admin raised
  /// by hand, and for one the system found on its own -- a title search whose
  /// proprietors do not match the owners we hold is nobody's report.
  raisedBySource ComplianceAlertSource?

  /// The alert in the raiser's own words where there are any -- the sentence
  /// from the architect's email, the note on the surveyor's covering letter.
  /// Display only; nothing keys on it.
  detail String? @db.Text

  /// Who closed it and when. Null while open.
  resolvedById   String?
  resolvedAt     DateTime?
  /// What closing it was justified by -- "replacement title search verified".
  resolutionNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement CertifierEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  resolvedBy User?               @relation("UserResolvedComplianceAlerts", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// At most one open alert of a type per file. The architect saying "this
  /// needs a DA" twice is one condition, not two, and the partial index is
  /// what keeps a resolved one from blocking a genuine recurrence later.
  @@index([engagementId])
  @@index([engagementId, status])
}

/// Lifecycle of a progress claim, mirroring Xero's own invoice status codes so
/// the webhook can map one to one without inventing intermediate states.
enum InvoiceStatus {
  DRAFT
  SUBMITTED
  AUTHORISED
  PAID
  VOIDED
  DELETED
}

/// The organisation's Xero OAuth2 connection.
///
/// A table rather than env vars because the refresh token ROTATES on every
/// refresh — Xero issues a new one and invalidates the old — so it has to be
/// written back somewhere durable. It also expires after 60 days without use,
/// which is why `refreshedAt` is tracked and surfaced on /admin/xero: a silent
/// expiry would stop every progress claim with no other symptom.
///
/// One active row in practice. `isActive` rather than a delete so a disconnect
/// leaves an audit trail of who connected what and when.
model XeroConnection {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  tenantName    String?
  accessToken   String
  refreshToken  String
  /// Access token expiry (Xero issues 30-minute tokens).
  expiresAt     DateTime
  /// Last successful token refresh — the 60-day refresh-token clock restarts here.
  refreshedAt   DateTime @default(now())
  scopes        String[]
  connectedById String?
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedBy User? @relation("XeroConnections", fields: [connectedById], references: [id])

  @@index([isActive])
  @@index([connectedById])
}

/// A progress claim raised in Xero against a completed ProjectStage.
///
/// `ProjectStage` is an enum, not a table, so a stage has no row to hang this
/// off — the claim keys on the (project, stage) pair instead, and that pair is
/// unique: a stage is claimed exactly once. That uniqueness IS the idempotency
/// guard for generation, which fires from a post-response hook that can run
/// more than once for the same stage.
///
/// Amounts are mirrored from Xero rather than computed here. Xero owns the
/// ledger; this table exists so the project page can show an invoice history
/// without a per-render API call, and so payment state has somewhere to land
/// when the webhook arrives.
model Invoice {
  id            String        @id @default(uuid())
  projectId     String
  projectStage  ProjectStage
  xeroInvoiceId String        @unique
  invoiceNumber String?
  reference     String?
  status        InvoiceStatus @default(AUTHORISED)
  currencyCode  String        @default("AUD")

  subTotal       Decimal @db.Decimal(12, 2)
  totalTax       Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  amountDue      Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountCredited Decimal @default(0) @db.Decimal(12, 2)

  issuedDate      DateTime
  dueDate         DateTime
  fullyPaidOnDate DateTime?

  /// Vercel Blob URL of the PDF Xero rendered, archived at creation so the
  /// invoice opens in our own file viewer instead of sending anyone to Xero.
  pdfUrl String?

  /// Xero's `updatedDateUTC` for the version this row reflects. The webhook
  /// refuses to apply an event older than this, so a replayed or out-of-order
  /// delivery cannot drag a PAID claim back to AUTHORISED.
  xeroUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, projectStage])
  @@index([projectId])
  @@index([status])
}
